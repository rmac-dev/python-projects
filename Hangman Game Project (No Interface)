import random

print("Hello. Let's Play Hangman!")

wordlist = [
    "Syzygy", "Rhythm", "Embellish", "Apparition", "Astrology", 
    "Extort", "Impound", "Deliver", "Deteriorate", "Provoke", 
    "Qualified", "Invincible", "Shortage", "Stethoscope", 
    "Reflection", "Operational", "Orchestra", "Separate", "Decide"
]

word_choice = random.choice(wordlist).lower()
display = ['_'] * len(word_choice)
total_tries = 6

print(f"The word has {len(word_choice)} letters.")

while total_tries > 0 and '_' in display:
    print("\nCurrent word:", " ".join(display))
    print(f"Guesses left: {total_tries}")
    
    letter = input("Please choose a character between A-Z: ").lower()

    if len(letter) != 1 or not letter.isalpha():
        print("Please enter a single valid letter.")
        continue

    if letter in word_choice:
        print("You have correctly guessed one of the letters!")
        # Reveal all instances of the guessed letter
        for i in range(len(word_choice)):
            if word_choice[i] == letter:
                display[i] = letter
    else:
        total_tries -= 1
        print(f"This letter is not in the word.")

# End of game checks
if '_' not in display:
    print(f"\nCongratulations! You guessed the word: {word_choice.capitalize()}")
else:
    print(f"\nGame Over! The word was: {word_choice.capitalize()}")
