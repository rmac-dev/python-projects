# Step 1: Initialize the grid
def create_grid(rows, cols):
    return [['O' for _ in range(cols)] for _ in range(rows)]
 
# Step 2: Add walls to the grid
def add_walls(grid, walls):
    for wall in walls:
        row, col = wall
        grid[row][col] = 'X'
 
 
# Step 3: Display the grid
def display_grid(grid):
    for row in grid:
        print(''.join(row))
 
# Example usage
rows, cols = 4, 3  # Grid size
grid = create_grid(rows, cols)
 
# List of wall positions (row, col)
walls = [(1,1), (2,1), (3,1)]
 
add_walls(grid, walls)
display_grid(grid)
 
 
import pygame
import random
from collections import deque
print("Welcome to the Maze game!")
help = input("Would you like to view game controls? y/n").lower()
if help == "y":
    print("\nUse the arrow-keys in their corresponding direction to move across grid.\nType 'R' key to reset if maze is unsolvable or if you want a different maze.\nPress spacebar to auto-solve the maze if you are stuck or lazy.\nEnjoy solving the Maze!")
else:
    print("Okay! If you change your mind, restart the program. Otherwise, Enjoy the maze game!")
# Maze dimensions (moderates the size of grid in window)
ROWS, COLS = 20, 20
CELL_SIZE = 30
MARGIN = 5
 
# Colour presets for: grid, background, player/exit, path colour and text.
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GREEN = (0, 255, 0)  # Player color
RED = (255, 0, 0)  # Exit color
BLUE = (0, 0, 255)  # Path color
 
def generate_maze(rows, cols):
    #Generates a maze using Depth-First Search.
    maze = [[1 for _ in range(cols)] for _ in range(rows)]  # 1 represents walls
    visited = [[False for _ in range(cols)] for _ in range(rows)]
 
    def dfs(row, col):
        visited[row][col] = True
        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]
        random.shuffle(directions)
 
        for dr, dc in directions:
            new_row, new_col = row + dr, col + dc
            if 0 <= new_row < rows and 0 <= new_col < cols and not visited[new_row][new_col]:
                maze[row][col + dc] = maze[row + dr][col] = 0  # Remove walls
                dfs(new_row, new_col)
 
    start_row, start_col = random.randint(0, rows - 1), random.randint(0, cols - 1)
    dfs(start_row, start_col)
 
    # Ensure there's an exit
    exit_row, exit_col = random.randint(0, rows - 1), random.randint(0, cols - 1)
    while (exit_row, exit_col) == (start_row, start_col):
        exit_row, exit_col = random.randint(0, rows - 1), random.randint(0, cols - 1)
    maze[start_row][start_col] = 0
    maze[exit_row][exit_col] = 0
 
    # Moderates chance of adding walls on each space to create a more challenging path
    for i in range(rows):
        for j in range(cols):
            if random.random() < 0.3 and (i, j) != (start_row, start_col) and (i, j) != (exit_row, exit_col):  # Never adds walls on start or exit space
                maze[i][j] = 1
    # Outputs the maze grid when program is running in game window.
    return maze, (start_row, start_col), (exit_row, exit_col)
 
def draw_maze(screen, maze, player_pos, exit_pos):
    #Draws the maze on the game window
    for row in range(ROWS):
        for col in range(COLS):
            color = WHITE if maze[row][col] == 1 else BLACK
            pygame.draw.rect(screen, color, [(MARGIN + CELL_SIZE) * col + MARGIN,
                                             (MARGIN + CELL_SIZE) * row + MARGIN,
                                             CELL_SIZE, CELL_SIZE])
 
    # Draw exit point
    exit_x = (MARGIN + CELL_SIZE) * exit_pos[1] + MARGIN + CELL_SIZE // 2
    exit_y = (MARGIN + CELL_SIZE) * exit_pos[0] + MARGIN + CELL_SIZE // 2
    pygame.draw.circle(screen, RED, (exit_x, exit_y), CELL_SIZE // 3)
 
def draw_player(screen, player_pos):
    #Draws the player on the screen.
    player_x = (MARGIN + CELL_SIZE) * player_pos[1] + MARGIN + CELL_SIZE // 2
    player_y = (MARGIN + CELL_SIZE) * player_pos[0] + MARGIN + CELL_SIZE // 2
    pygame.draw.circle(screen, GREEN, (player_x, player_y), CELL_SIZE // 3)
 
def draw_path(screen, path):
    #Draws the solved path on the screen once maze is completed.
    for pos in path:
        x = (MARGIN + CELL_SIZE) * pos[1] + MARGIN + CELL_SIZE // 2
        y = (MARGIN + CELL_SIZE) * pos[0] + MARGIN + CELL_SIZE // 2
        pygame.draw.circle(screen, BLUE, (x, y), CELL_SIZE // 5)
 
def solve_maze(maze, start_pos, exit_pos):
    #Solves the maze using Breadth-First Search.
    rows, cols = len(maze), len(maze[0])
    queue = deque([(start_pos, [])])  # Queue to store nodes to explore
    visited = set()
 
    while queue:
        current_pos, path = queue.popleft()
        row, col = current_pos
        # When player moves onto
        if current_pos == exit_pos:
            return path + [current_pos]  # Return the path
 
        visited.add(current_pos)
        #
        for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
            new_row, new_col = row + dr, col + dc
            if 0 <= new_row < rows and 0 <= new_col < cols and maze[new_row][new_col] == 0 and (new_row, new_col) not in visited:
                queue.append(((new_row, new_col), path + [current_pos]))
 
    return None  # No path found
 
def main():
    pygame.init()
    screen_width = (MARGIN + CELL_SIZE) * COLS + MARGIN
    screen_height = (MARGIN + CELL_SIZE) * ROWS + MARGIN
    screen = pygame.display.set_mode((screen_width, screen_height))
    pygame.display.set_caption("Maze Game")
 
    maze, start_pos, exit_pos = generate_maze(ROWS, COLS)
    player_pos = start_pos
    solved = False
    path = None
 
    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
 
            # Handle player movement (replace with arrow key handling)
            keys = pygame.key.get_pressed()
            if keys[pygame.K_LEFT] and player_pos[1] > 0 and maze[player_pos[0]][player_pos[1] - 1] == 0:
                player_pos = (player_pos[0], player_pos[1] - 1)
            if keys[pygame.K_RIGHT] and player_pos[1] < COLS - 1 and maze[player_pos[0]][player_pos[1] + 1] == 0:
                player_pos = (player_pos[0], player_pos[1] + 1)
            if keys[pygame.K_UP] and player_pos[0] > 0 and maze[player_pos[0] - 1][player_pos[1]] == 0:
                player_pos = (player_pos[0] - 1, player_pos[1])
            if keys[pygame.K_DOWN] and player_pos[0] < ROWS - 1 and maze[player_pos[0] + 1][player_pos[1]] == 0:
                player_pos = (player_pos[0] + 1, player_pos[1])
 
            # Handle solve button (replace with actual button implementation)
            if keys[pygame.K_SPACE]:
                path = solve_maze(maze, start_pos, exit_pos)
                solved = True
               
                # Handle reset button
            if keys[pygame.K_r]:
                maze, start_pos, exit_pos = generate_maze(ROWS, COLS)
                player_pos = start_pos
                solved = False
                path = None
 
        screen.fill(BLACK)
        draw_maze(screen, maze, player_pos, exit_pos)
        draw_player(screen, player_pos)
 
        if solved:
            draw_path(screen, path)
 
        # Check for win condition
        if player_pos == exit_pos:
            font = pygame.font.Font(None, 36)
            text = font.render("You Have Escaped The Maze!", True, GREEN)
            text_rect = text.get_rect(center=(screen_width // 2, screen_height // 2))
            screen.blit(text, text_rect)
            running = False  # End the game
 
        pygame.display.flip()
 
    pygame.quit()
 
if __name__ == "__main__":
    main()
 
